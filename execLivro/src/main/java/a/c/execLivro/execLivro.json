{
    "info": {
        "name": "execLivro - Biblioteca API",
        "description": "Coleção de testes para a API Spring Boot do projeto execLivro (biblioteca).",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "https://opulent-zebra-4j9j7646wgxxf7wwq-8080.app.github.dev"
        }
    ],
    "item": [
        {
            "name": "Mensagem de boas-vindas",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/",
                    "host": ["{{baseUrl}}"],
                    "path": [""]
                },
                "description": "Retorna a mensagem de boas-vindas da biblioteca."
            },
            "response": []
        },
        {
            "name": "Listar livros",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/livros",
                    "host": ["{{baseUrl}}"],
                    "path": ["livros"]
                },
                "description": "Retorna a lista completa de livros cadastrados."
            },
            "response": []
        },
        {
            "name": "Buscar livro por id",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/livros/10",
                    "host": ["{{baseUrl}}"],
                    "path": ["livros", "10"]
                },
                "description": "Busca um livro específico pelo id."
            },
            "response": []
        },
        {
            "name": "Criar livro",
            "request": {
                "method": "POST",
                "header": [
                    { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"id\": 200,\n    \"titulo\": \"Livro Novo\",\n    \"autor\": { \"id\": 1 },\n    \"ano\": 2024\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/livros",
                    "host": ["{{baseUrl}}"],
                    "path": ["livros"]
                },
                "description": "Cria um novo livro. O campo autor referencia o id de um Autor já existente no banco."
            },
            "response": []
        },
        {
            "name": "Remover livro",
            "request": {
                "method": "DELETE",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/livros/200",
                    "host": ["{{baseUrl}}"],
                    "path": ["livros", "200"]
                },
                "description": "Remove um livro pelo id. Retorna 204 se removido, 404 se não existir."
            },
            "response": []
        },
        {
            "name": "Listar autores",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/autores",
                    "host": ["{{baseUrl}}"],
                    "path": ["autores"]
                },
                "description": "Retorna a lista de nomes de autores."
            },
            "response": []
        },
        {
            "name": "Livros por autor e ano",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/livros/autor/Huguinho Pato/ano/2022",
                    "host": ["{{baseUrl}}"],
                    "path": ["livros", "autor", "Huguinho Pato", "ano", "2022"]
                },
                "description": "Retorna títulos de um autor num ano específico. Também registra a consulta nas estatísticas."
            },
            "response": []
        },
        {
            "name": "Autor mais consultado",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/autorMaisConsultado",
                    "host": ["{{baseUrl}}"],
                    "path": ["autorMaisConsultado"]
                },
                "description": "Retorna o autor mais consultado até o momento."
            },
            "response": []
        },
        {
            "name": "Autor menos consultado",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/autorMenosConsultado",
                    "host": ["{{baseUrl}}"],
                    "path": ["autorMenosConsultado"]
                },
                "description": "Retorna o autor menos consultado até o momento."
            },
            "response": []
        },
        {
            "name": "Todas as contagens",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/todasAsContagens",
                    "host": ["{{baseUrl}}"],
                    "path": ["todasAsContagens"]
                },
                "description": "Retorna o mapa completo de autor -> número de consultas."
            },
            "response": []
        }
    ]
}
