{
    "info": {
        "name": "execLivro - Biblioteca API",
        "description": "Coleção completa de testes para a API Spring Boot do projeto execLivro (biblioteca), com autenticação.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "auth": {
        "type": "basic",
        "basic": [
            { "key": "username", "value": "{{username}}", "type": "string" },
            { "key": "password", "value": "{{password}}", "type": "string" }
        ]
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "https://stunning-guacamole-wrjr7x6xg9gphgww9-8080.app.github.dev"
        },
        {
            "key": "username",
            "value": "admin"
        },
        {
            "key": "password",
            "value": "admin123"
        }
    ],
    "item": [
        {
            "name": "Livros",
            "item": [
                {
                    "name": "Mensagem de boas-vindas",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": { "raw": "{{baseUrl}}/", "host": ["{{baseUrl}}"], "path": [""] }
                    },
                    "response": []
                },
                {
                    "name": "Listar livros",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": { "raw": "{{baseUrl}}/livros", "host": ["{{baseUrl}}"], "path": ["livros"] }
                    },
                    "response": []
                },
                {
                    "name": "Buscar livro por id",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": { "raw": "{{baseUrl}}/livros/10", "host": ["{{baseUrl}}"], "path": ["livros", "10"] }
                    },
                    "response": []
                },
                {
                    "name": "Criar livro (ADMIN)",
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"id\": 200,\n    \"titulo\": \"Livro Novo\",\n    \"autor\": { \"id\": 1 },\n    \"ano\": 2024\n}"
                        },
                        "url": { "raw": "{{baseUrl}}/livros", "host": ["{{baseUrl}}"], "path": ["livros"] }
                    },
                    "response": []
                },
                {
                    "name": "Atualizar livro (ADMIN)",
                    "request": {
                        "method": "PUT",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"id\": 200,\n    \"titulo\": \"Livro Atualizado\",\n    \"autor\": { \"id\": 1 },\n    \"ano\": 2025\n}"
                        },
                        "url": { "raw": "{{baseUrl}}/livros/200", "host": ["{{baseUrl}}"], "path": ["livros", "200"] }
                    },
                    "response": []
                },
                {
                    "name": "Remover livro (ADMIN)",
                    "request": {
                        "method": "DELETE",
                        "header": [],
                        "url": { "raw": "{{baseUrl}}/livros/200", "host": ["{{baseUrl}}"], "path": ["livros", "200"] }
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "Autores",
            "item": [
                {
                    "name": "Listar autores",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": { "raw": "{{baseUrl}}/autores", "host": ["{{baseUrl}}"], "path": ["autores"] }
                    },
                    "response": []
                },
                {
                    "name": "Livros por autor e ano",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/livros/autor/Huguinho Pato/ano/2022",
                            "host": ["{{baseUrl}}"],
                            "path": ["livros", "autor", "Huguinho Pato", "ano", "2022"]
                        }
                    },
                    "response": []
                },
                {
                    "name": "Autor mais consultado",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": { "raw": "{{baseUrl}}/autorMaisConsultado", "host": ["{{baseUrl}}"], "path": ["autorMaisConsultado"] }
                    },
                    "response": []
                },
                {
                    "name": "Autor menos consultado",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": { "raw": "{{baseUrl}}/autorMenosConsultado", "host": ["{{baseUrl}}"], "path": ["autorMenosConsultado"] }
                    },
                    "response": []
                },
                {
                    "name": "Todas as contagens",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": { "raw": "{{baseUrl}}/todasAsContagens", "host": ["{{baseUrl}}"], "path": ["todasAsContagens"] }
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "Usuarios (biblioteca)",
            "item": [
                {
                    "name": "Cadastrar usuario (ADMIN)",
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"id\": 1,\n    \"nome\": \"Maria Silva\"\n}"
                        },
                        "url": { "raw": "{{baseUrl}}/usuarios", "host": ["{{baseUrl}}"], "path": ["usuarios"] }
                    },
                    "response": []
                },
                {
                    "name": "Buscar usuario por id",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": { "raw": "{{baseUrl}}/usuarios/1", "host": ["{{baseUrl}}"], "path": ["usuarios", "1"] }
                    },
                    "response": []
                },
                {
                    "name": "Listar livros lidos",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": { "raw": "{{baseUrl}}/usuarios/1/livrosLidos", "host": ["{{baseUrl}}"], "path": ["usuarios", "1", "livros-lidos"] }
                    },
                    "response": []
                },
                {
                    "name": "Marcar livro como lido (ADMIN ou CONSULTA)",
                    "request": {
                        "method": "PUT",
                        "header": [],
                        "url": { "raw": "{{baseUrl}}/usuarios/1/livrosLidos/10", "host": ["{{baseUrl}}"], "path": ["usuarios", "1", "livros-lidos", "10"] }
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "Usuarios do Sistema (autenticação)",
            "item": [
                {
                    "name": "Cadastrar usuario do sistema (ADMIN)",
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"username\": \"bibliotecario1\",\n    \"senha\": \"senha123\",\n    \"perfil\": \"CONSULTA\"\n}"
                        },
                        "url": { "raw": "{{baseUrl}}/usuarios-sistema", "host": ["{{baseUrl}}"], "path": ["usuarios-sistema"] },
                        "description": "Só ADMIN pode cadastrar novos funcionários do sistema."
                    },
                    "response": []
                }
            ]
        }
    ]
}
