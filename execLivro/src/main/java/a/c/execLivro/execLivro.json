{
    "info": {
        "name": "execLivro - Biblioteca API",
        "description": "Coleção completa de testes para a API Spring Boot do projeto execLivro (biblioteca).",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "https://stunning-guacamole-wrjr7x6xg9gphgww9-8080.app.github.dev"
        }
    ],
    "item": [
        {
            "name": "Livros",
            "item": [
                {
                    "name": "Mensagem de boas-vindas",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": { "raw": "{{baseUrl}}/", "host": ["{{baseUrl}}"], "path": [""] },
                        "description": "Retorna a mensagem de boas-vindas da biblioteca."
                    },
                    "response": []
                },
                {
                    "name": "Listar livros",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": { "raw": "{{baseUrl}}/livros", "host": ["{{baseUrl}}"], "path": ["livros"] },
                        "description": "Retorna a lista completa de livros, cada um com o objeto autor aninhado."
                    },
                    "response": []
                },
                {
                    "name": "Buscar livro por id",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": { "raw": "{{baseUrl}}/livros/10", "host": ["{{baseUrl}}"], "path": ["livros", "10"] },
                        "description": "Busca um livro específico pelo id."
                    },
                    "response": []
                },
                {
                    "name": "Criar livro",
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"id\": 200,\n    \"titulo\": \"Livro Novo\",\n    \"autor\": { \"id\": 1 },\n    \"ano\": 2024\n}"
                        },
                        "url": { "raw": "{{baseUrl}}/livros", "host": ["{{baseUrl}}"], "path": ["livros"] },
                        "description": "Cria um novo livro. O autor referencia o id de um Autor já existente."
                    },
                    "response": []
                },
                {
                    "name": "Atualizar livro",
                    "request": {
                        "method": "PUT",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"id\": 200,\n    \"titulo\": \"Livro Atualizado\",\n    \"autor\": { \"id\": 1 },\n    \"ano\": 2025\n}"
                        },
                        "url": { "raw": "{{baseUrl}}/livros/200", "host": ["{{baseUrl}}"], "path": ["livros", "200"] },
                        "description": "Atualiza um livro existente pelo id."
                    },
                    "response": []
                },
                {
                    "name": "Remover livro",
                    "request": {
                        "method": "DELETE",
                        "header": [],
                        "url": { "raw": "{{baseUrl}}/livros/200", "host": ["{{baseUrl}}"], "path": ["livros", "200"] },
                        "description": "Remove um livro pelo id. 204 se removido, 404 se não existir."
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "Autores",
            "item": [
                {
                    "name": "Listar autores",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": { "raw": "{{baseUrl}}/autores", "host": ["{{baseUrl}}"], "path": ["autores"] },
                        "description": "Retorna a lista de nomes de autores."
                    },
                    "response": []
                },
                {
                    "name": "Livros por autor e ano",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/livros/autor/Huguinho Pato/ano/2022",
                            "host": ["{{baseUrl}}"],
                            "path": ["livros", "autor", "Huguinho Pato", "ano", "2022"]
                        },
                        "description": "Retorna títulos de um autor num ano específico. Registra a consulta nas estatísticas."
                    },
                    "response": []
                },
                {
                    "name": "Autor mais consultado",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": { "raw": "{{baseUrl}}/autorMaisConsultado", "host": ["{{baseUrl}}"], "path": ["autorMaisConsultado"] },
                        "description": "Retorna o autor mais consultado até o momento."
                    },
                    "response": []
                },
                {
                    "name": "Autor menos consultado",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": { "raw": "{{baseUrl}}/autorMenosConsultado", "host": ["{{baseUrl}}"], "path": ["autorMenosConsultado"] },
                        "description": "Retorna o autor menos consultado até o momento."
                    },
                    "response": []
                },
                {
                    "name": "Todas as contagens",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": { "raw": "{{baseUrl}}/todasAsContagens", "host": ["{{baseUrl}}"], "path": ["todasAsContagens"] },
                        "description": "Retorna o mapa completo de autor -> número de consultas."
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "Usuarios",
            "item": [
                {
                    "name": "Cadastrar usuario",
                    "request": {
                        "method": "POST",
                        "header": [{ "key": "Content-Type", "value": "application/json" }],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"id\": 1,\n    \"nome\": \"Maria Silva\"\n}"
                        },
                        "url": { "raw": "{{baseUrl}}/usuarios", "host": ["{{baseUrl}}"], "path": ["usuarios"] },
                        "description": "Cria um novo usuário da biblioteca. Valida nome (NotBlank, 3-80 chars) e id positivo."
                    },
                    "response": []
                },
                {
                    "name": "Buscar usuario por id",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": { "raw": "{{baseUrl}}/usuarios/1", "host": ["{{baseUrl}}"], "path": ["usuarios", "1"] },
                        "description": "Busca um usuário pelo id."
                    },
                    "response": []
                },
                {
                    "name": "Listar livros lidos",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/usuarios/1/livros-lidos",
                            "host": ["{{baseUrl}}"],
                            "path": ["usuarios", "1", "livros-lidos"]
                        },
                        "description": "Lista os livros que o usuário já leu. Retorna [] se nenhum, 404 se usuário não existe."
                    },
                    "response": []
                },
                {
                    "name": "Marcar livro como lido",
                    "request": {
                        "method": "PUT",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/usuarios/1/livros-lidos/10",
                            "host": ["{{baseUrl}}"],
                            "path": ["usuarios", "1", "livros-lidos", "10"]
                        },
                        "description": "Marca o livro (id 10) como lido pelo usuário (id 1). Retorna 204."
                    },
                    "response": []
                }
            ]
        }
    ]
}
